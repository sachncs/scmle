---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  current: string;
}

const { title, description, current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const links = [
  { href: `${base}/docs/`, label: "Start here", key: "start" },
  { href: `${base}/docs/quickstart/`, label: "Quickstart", key: "quickstart" },
  { href: `${base}/docs/data/`, label: "Data & curation", key: "data" },
  { href: `${base}/docs/modalities/`, label: "Modality lifecycles", key: "modalities" },
  { href: `${base}/docs/extensions/`, label: "Extension contracts", key: "extensions" },
  { href: `${base}/docs/capabilities/`, label: "Capability matrix", key: "capabilities" },
  { href: `${base}/docs/modeling/`, label: "Modelling & estimation", key: "modeling" },
  { href: `${base}/docs/evidence/`, label: "Evidence & gates", key: "evidence" },
  { href: `${base}/docs/workflows/`, label: "Workflows", key: "workflows" },
  { href: `${base}/docs/api/`, label: "Python API", key: "api" },
  { href: `${base}/docs/architecture/`, label: "Architecture", key: "architecture" },
  { href: `${base}/docs/cards/`, label: "Cards & explanations", key: "cards" },
  { href: `${base}/docs/operations/`, label: "Operations", key: "operations" },
  { href: `${base}/docs/security/`, label: "Security", key: "security" },
  { href: `${base}/docs/recovery/`, label: "Recovery", key: "recovery" },
  { href: `${base}/docs/migrations/`, label: "Migrations", key: "migrations" },
  { href: `${base}/docs/troubleshooting/`, label: "Troubleshooting", key: "troubleshooting" },
];
const path = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) || "/" : Astro.url.pathname;
const currentIndex = links.findIndex((link) => link.key === current);
const previous = currentIndex > 0 ? links[currentIndex - 1] : null;
const next = currentIndex >= 0 && currentIndex < links.length - 1 ? links[currentIndex + 1] : null;
---

<BaseLayout title={`${title} · Docs`} description={description} path={path} section="docs">
  <div class="docs-shell container">
    <aside class="sidebar" aria-label="Documentation">
      <p class="sidebar-label">Documentation</p>
      <div class="filter">
        <label class="sr-only" for="doc-filter">Filter documentation pages</label>
        <input id="doc-filter" type="search" placeholder="Filter pages  ( / )" autocomplete="off" />
      </div>
      <nav aria-label="Documentation pages">
        {links.map((link, i) => (
          <a aria-current={current === link.key ? "page" : undefined} href={link.href}>
            <span>{String(i + 1).padStart(2, "0")}</span>{link.label}
          </a>
        ))}
      </nav>
      <p class="filter-empty" hidden>No matching pages.</p>
      <p class="sidebar-foot">Documents the 0.1 beta line.</p>
    </aside>

    <main id="main" class="docs-content">
      <slot />
      <nav class="docs-pager" aria-label="Previous and next page">
        {previous ? <a class="prev" rel="prev" href={previous.href}><span>← Previous</span><strong>{previous.label}</strong></a> : <span></span>}
        {next ? <a class="next" rel="next" href={next.href}><span>Next →</span><strong>{next.label}</strong></a> : <span></span>}
      </nav>
    </main>
  </div>
</BaseLayout>
