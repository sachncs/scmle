---
import "../styles/tokens.css";
import "../styles/site.css";
import "../styles/landing.css";
import "../styles/docs.css";

interface Props {
  title: string;
  description: string;
  /** Path below the site base, e.g. "/docs/quickstart/". */
  path?: string;
  /** Shown before the site name in the <title>; the home page passes a full title. */
  fullTitle?: boolean;
  noindex?: boolean;
  section?: "home" | "docs" | "other";
}

const { title, description, path = "/", fullTitle = false, noindex = false, section = "other" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const origin = "https://sachncs.github.io";
const canonical = `${origin}${base}${path}`;
const pageTitle = fullTitle ? title : `${title} · SCMLE`;
const image = `${origin}${base}/og.png`;
const imageAlt = "SCMLE: Mathematics meets engineering. A curation-first machine learning lifecycle.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "SCMLE",
  description: "A curation-first machine learning lifecycle with leakage-safe evaluation and signed artifacts.",
  codeRepository: "https://github.com/sachncs/scmle",
  programmingLanguage: "Python",
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  url: `${origin}${base}/`,
};
const nav = [
  { href: `${base}/#lifecycle`, label: "Lifecycle" },
  { href: `${base}/#capabilities`, label: "Capabilities" },
  { href: `${base}/#benchmarks`, label: "Benchmarks" },
  { href: `${base}/#trust`, label: "Trust" },
  { href: `${base}/docs/`, label: "Docs", docs: true },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}/favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta property="og:site_name" content="SCMLE" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script is:inline>
      (function () {
        var r = document.documentElement;
        r.classList.add("js");
        try {
          var t = localStorage.getItem("scmle-theme");
          if (t === "light" || t === "dark") r.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
    {section === "home" && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={`${base}/`} aria-label="SCMLE home">
          <img src={`${base}/scmle-mark.svg`} alt="" width="28" height="28" />
          <span>SCMLE</span>
        </a>
        <nav class="primary-nav" aria-label="Primary">
          {nav.map((n) => <a href={n.href} aria-current={n.docs && section === "docs" ? "page" : undefined}>{n.label}</a>)}
        </nav>
        <div class="header-actions">
          <a class="plain hide-xs" href="https://github.com/sachncs/scmle">GitHub</a>
          <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Switch theme">
            <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z" /></svg>
            <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
          <a class="btn btn-primary" href={`${base}/docs/quickstart/`}>Get started</a>
          <details class="menu">
            <summary class="icon-btn" aria-label="Menu">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
            </summary>
            <div class="menu-panel">
              {nav.map((n) => <a href={n.href}>{n.label}</a>)}
              <a href="https://github.com/sachncs/scmle">GitHub</a>
            </div>
          </details>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <a class="brand" href={`${base}/`} aria-label="SCMLE home"><img src={`${base}/scmle-mark.svg`} alt="" width="28" height="28" /><span>SCMLE</span></a>
            <p>Mathematics meets engineering. A curation-first, leakage-safe machine learning lifecycle.</p>
          </div>
          <div class="footer-col">
            <h2>Product</h2>
            <ul>
              <li><a href={`${base}/#lifecycle`}>Lifecycle</a></li>
              <li><a href={`${base}/#capabilities`}>Capabilities</a></li>
              <li><a href={`${base}/#benchmarks`}>Benchmarks</a></li>
              <li><a href={`${base}/#trust`}>Trust</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h2>Documentation</h2>
            <ul>
              <li><a href={`${base}/docs/quickstart/`}>Quickstart</a></li>
              <li><a href={`${base}/docs/api/`}>Python API</a></li>
              <li><a href={`${base}/docs/architecture/`}>Architecture</a></li>
              <li><a href={`${base}/docs/security/`}>Security</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h2>Project</h2>
            <ul>
              <li><a href="https://github.com/sachncs/scmle">GitHub</a></li>
              <li><a href="https://github.com/sachncs/scmle/issues">Issues</a></li>
              <li><a href="https://www.apache.org/licenses/LICENSE-2.0">Apache-2.0 license</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-legal">
          <span>Open source under Apache-2.0. Currently 0.1 beta.</span>
          <span>© 2026 SCMLE contributors</span>
        </div>
      </div>
    </footer>
    <script>
      import "../scripts/site.js";
    </script>
  </body>
</html>
