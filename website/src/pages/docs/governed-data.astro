const backends = [
  ["Directory", "<code>LocalObjectStore(root)</code>", "none"],
];
const policies = [
  ["<code>fail</code>", "<code>QualityGateError</code> with the report; nothing continues."],
  ["<code>quarantine</code>", "Row-level rules remove the rows and write them with the report under <code>quarantine/&lt;snapshot id&gt;/</code>. Dataset-level rules (<code>SchemaCheck</code>, <code>FreshnessCheck</code>, <code>MinRowsCheck</code>, <code>NullFractionCheck</code>) hold the whole snapshot: a marker is written, the run stops, and the same snapshot is refused until a person calls <code>release</code>."],
  ["<code>warn</code>", "Recorded in the report, data unchanged."],
];
