const layout = [
  ["<code>scmle.contracts</code>", "Typed contracts: pydantic configuration, frozen dataclasses for data, metrics, artifacts, events, abstract base classes."],
  ["<code>scmle.data</code>", "Readers (CSV, Parquet, Arrow and Polars interchange), profiling, validation (column kinds, target and task), curation (fold-local preprocessing), splitting (leakage-safe and structure-aware strategies), and the qualification packages (charter, custody, ledger, admissibility, detectors, robustness, identification)."],
  ["<code>scmle.features</code>", "Versioned, fitted feature graph (row-wise and series nodes)."],
  ["<code>scmle.sampling</code>", "Resamplers, synthesis, and the data strategies evaluated inside folds."],
  ["<code>scmle.models</code>", "The model adapter hierarchy and registry, scikit-learn and boosting adapters, conformance, thresholds, stacking."],
  ["<code>scmle.optimization</code>", "Ask/tell optimizers (random, Optuna)."],
  ["<code>scmle.experimentation</code>", "Trials, tuning, strategy and ensemble search, experiment stores (SQLite)."],
  ["<code>scmle.intelligence</code>", "Dataset fingerprint, planner and planning rules, recommendations, meta-learning from run history."],
  ["<code>scmle.evaluation</code>", "Metric catalog, selection policies, diagnostics, resource measurement, conformal intervals."],
  ["<code>scmle.explainability</code>", "Permutation importance, partial dependence, per-prediction occlusion."],
  ["<code>scmle.core</code>", "State machine, workflow compiler, stage hierarchy, policy checkpoints, limits, execution backends, configuration files, orchestrator."],
  ["<code>scmle.artifacts</code>", "Signed model bundle, run store, report, replay verification."],
  ["<code>scmle.inference</code>", "Column mapping, input validation, batch and HTTP serving."],
  ["<code>scmle.monitoring</code>", "Reference profiles, drift, delayed-label performance, champion-challenger."],
  ["<code>scmle.governance</code>", "Access ledger, content-addressed model registry, lifecycle manager, run audit, release states."],
  ["<code>scmle.security</code>, <code>scmle.deploy</code>, <code>scmle.runners</code>, <code>scmle.workflow</code>", "Token verification and audit, packaging and release gates, portable training runners, and workflow definitions."],
  ["<code>scmle.integrations</code>", "Optional MLflow and Ray adapters."],
  ["<code>scmle.unsupervised</code>", "Clustering model search and scoring."],
