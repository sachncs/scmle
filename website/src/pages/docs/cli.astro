const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const commands = [
  ["<code>scmle plan DATA --target COL</code>", "Profile the data and print the proposed plan. Trains nothing."],
  ["<code>scmle run DATA --target COL</code>", "Execute the full workflow and write a <code>runs/run_*</code> directory."],
  ["<code>scmle resume RUN_DIR</code>", "Continue a cancelled, failed or crashed run, reusing finished trials."],
  ["<code>scmle catalog INPUT</code>", "Catalog a local table (or raw bytes) into a JSON artifact."],
  ["<code>scmle predict BUNDLE DATA</code>", "Score a file with a saved bundle."],
  ["<code>scmle batch BUNDLE DATA</code>", "Score a file through the same code path as the online service. Writes <code>--output</code> and <code>&lt;output&gt;.manifest.json</code> (model version, artifact digest, row counts). <code>--on-null</code> and <code>--on-unseen</code> accept <code>reject</code>."],
  ["<code>scmle serve BUNDLE</code>", "Serve a bundle over HTTP: <code>/livez</code>, <code>/readyz</code>, <code>/predict</code>. See the <a href=\"" + base + "/docs/service/\">serving contract</a>."],
  ["<code>scmle export-onnx BUNDLE</code>", "Export an ONNX graph (needs the <code>onnx</code> extra)."],
  ["<code>scmle package BUNDLE</code>", "Write a hardened service folder: pinned-base Dockerfile, locked requirements, SBOM, signed provenance and <code>build.sh</code>. Sign with <code>SCMLE_SIGNING_KEY</code>."],
  ["<code>scmle charter init|check|sign PATH</code>", "Create, validate or sign an analysis charter."],
  ["<code>scmle claims list|show|verify RUN_DIR</code>", "List the claims of a charter run, show one with its hypothesis and checks, or verify the run's ledger and claims. <code>verify</code> exits 1 when any step fails."],
  ["<code>scmle frame REQUEST --source S --data X --output DIR</code>", "Draft an unsigned charter, a cost-model record and the questions only a person can answer, from a plain request. Exit 2 when refused."],
  ["<code>scmle ingest</code>", "Profile a read-only SQLite source, find grain and joins, and write the ingestion catalog (see <a href=\"" + base + "/docs/artifacts/#ingest\">artifacts</a>)."],
  ["<code>scmle loop init|verify</code>", "Open and verify the hash-chained deployment ledger of the closed loop."],
  ["<code>scmle deploy …</code>", "Live checks, the promotion gate, signed deployment records, platform observation and reconcile. See <a href=\"" + base + "/docs/cloud-release/\">Cloud release</a>."],
];
const options = [
  ["<code>--target COL [COL …]</code>", "Target column(s). Required."],
  ["<code>--task</code>, <code>--metric</code>", "Override the resolved task or metric."],
  ["<code>--time-budget S</code>, <code>--workers N</code>", "Search budget in seconds and parallel trials."],
  ["<code>--validation</code>", "<code>auto</code>, <code>stratified</code>, <code>random</code>, <code>group</code>, <code>temporal</code>, <code>rolling</code> and more."],
  ["<code>--group-column</code>, <code>--time-column</code>, <code>--weight-column</code>", "Describe the structure of the data."],
  ["<code>--exclude</code>, <code>--id-columns</code>, <code>--unavailable-at-prediction</code>", "Keep columns out of the features."],
  ["<code>--leakage-policy {warn,block}</code>", "<code>block</code> stops the run on suspicious features that have a passing certificate."],
  ["<code>--charter FILE</code>", "Govern the run by an analysis charter: a sealed confirmation set is split off before profiling."],
  ["<code>--exclude-models</code>, <code>--exclude-families</code>", "Restrict the search."],
  ["<code>--output-dir</code>, <code>--seed</code>", "Where runs go; reproducibility."],
  ["<code>--config FILE</code>", "Read a complete project specification (the format of <code>config.json</code>)."],
];
