---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { docsNav } from "../../data/docsNav";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Numbers match the sidebar. The overview itself is number 01 and is not listed as a card.
let number = 0;
const sections = docsNav
  .map((group) => ({
    title: group.title,
    pages: group.pages.map((p) => ({ ...p, number: (number += 1) })).filter((p) => p.slug !== ""),
  }))
  .filter((group) => group.pages.length > 0);
---

<DocsLayout
  title="Overview"
  description="Documentation for SCMLE: install the framework, run a curation-first workflow, and read every reference, operations and trust page without leaving the site."
  current="start"
>
  <p class="eyebrow"><span></span> Documentation</p>
  <h1>Start with the data.<br /><em>Ship with evidence.</em></h1>
  <p class="lead">A practical path from your first install to a reproducible, monitored ML workflow. SCMLE treats curation as a first-class engineering job and modelling as one measured step inside it. Everything you need is on this site.</p>

  <div class="callout"><p><strong>New here?</strong> Follow the <a href={`${base}/docs/quickstart/`}>quickstart</a> first. It takes a table, profiles it, validates the split, trains a small candidate set, and leaves an auditable run directory behind.</p></div>

  {sections.map((group) => (
    <>
      <h2>{group.title}</h2>
      <div class="doc-cards">
        {group.pages.map((p) => (
          <a class="doc-card" href={`${base}/docs/${p.slug}/`}><small>{String(p.number).padStart(2, "0")} / {group.title.toUpperCase()}</small><h3>{p.label}</h3><p>{p.summary}</p></a>
        ))}
      </div>
    </>
  ))}

  <h2>What you will learn</h2>
  <ol>
    <li>How to give heterogeneous tabular data a stable identity before modelling.</li>
    <li>How leakage-safe validation and curation findings shape the experiment plan.</li>
    <li>How run artifacts, signed bundles, and monitoring reports make decisions inspectable.</li>
  </ol>
  <p class="meta">Documentation follows the 0.1 beta API · Last reviewed November 2026</p>
</DocsLayout>
