---
const pillars = [
  {
    number: "01",
    title: "Understand the data",
    copy: "Profiles, validates, fingerprints, and stress-tests the dataset before a model ever sees it.",
  },
  {
    number: "02",
    title: "Curate with evidence",
    copy: "Leakage-safe splits, missingness plans, feature provenance, and auditable decisions turn raw tables into trustworthy inputs.",
  },
  {
    number: "03",
    title: "Model with restraint",
    copy: "Use the smallest compatible model that meets the objective, then package, monitor, and reproduce the result.",
  },
];

const capabilities = [
  "CSV, Parquet, Arrow, Feather, Polars, and streaming tables",
  "Temporal, group-aware, stratified, and leakage-safe validation",
  "Missingness, duplicates, drift, representativeness, and label quality",
  "Signed bundles, lineage, replay checks, and operational monitoring",
];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="SCMLE brings mathematics and engineering together for trustworthy machine learning workflows." />
    <link rel="canonical" href="https://sachncs.github.io/scmle/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sachncs.github.io/scmle/" />
    <meta property="og:title" content="SCMLE — mathematics meets engineering" />
    <meta property="og:description" content="A curation-first machine learning lifecycle for teams that need evidence, not just scores." />
    <meta name="twitter:card" content="summary" />
    <title>SCMLE — mathematics meets engineering</title>
  </head>
  <body>
    <header class="nav shell">
      <a class="brand" href={`${base}/`} aria-label="SCMLE home">
        <img class="brand-logo" src={`${base}/scmle-mark.svg`} alt="" />
        <span>SCMLE</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#approach">Approach</a>
        <a href="#capabilities">Capabilities</a>
        <a href="https://github.com/sachncs/scmle">GitHub ↗</a>
      </nav>
        <a class="nav-cta" href={`${base}/docs/`}>Read the docs <span>→</span></a>
    </header>

    <main>
      <section class="hero shell">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Mathematics meets engineering</p>
          <h1>Evidence in.<br /><em>Confidence out.</em></h1>
          <p class="lede">SCMLE is a Python workflow for turning imperfect data into reproducible machine learning systems: mathematically disciplined, operationally grounded, and ready to explain.</p>
          <div class="hero-actions">
            <a class="button button-primary" href={`${base}/docs/`}>Explore the docs <span>→</span></a>
            <a class="text-link" href="#approach">See how it works <span>↓</span></a>
          </div>
        </div>
        <div class="hero-art" aria-label="Dataset curation workflow illustration">
          <div class="orbit orbit-one"></div>
          <div class="orbit orbit-two"></div>
          <div class="data-card card-main">
            <div class="card-top"><span class="status-dot"></span><span>example curation pass</span><b>review</b></div>
            <div class="signal"><span class="signal-label">schema</span><span class="signal-bar"><i style="width: 94%"></i></span><strong>clean</strong></div>
            <div class="signal"><span class="signal-label">leakage</span><span class="signal-bar"><i style="width: 100%"></i></span><strong>blocked</strong></div>
            <div class="signal"><span class="signal-label">coverage</span><span class="signal-bar"><i style="width: 86%"></i></span><strong>ready</strong></div>
            <div class="card-foot"><span>illustrative workflow</span><span>01 / 03</span></div>
          </div>
          <div class="data-card card-chip chip-left"><span class="chip-icon">⌁</span><span>raw tables</span></div>
          <div class="data-card card-chip chip-right"><span class="chip-icon">✓</span><span>audited bundle</span></div>
          <div class="crosshair">+</div>
        </div>
      </section>

      <section class="ticker" aria-label="Project principles">
        <div class="ticker-inner shell"><span>MATHEMATICS</span><i>∑</i><span>ENGINEERING</span><i>∫</i><span>EVIDENCE</span><i>→</i><span>MATHEMATICS</span></div>
      </section>

      <section class="approach shell" id="approach">
        <div class="section-intro"><p class="eyebrow"><span></span> The operating principle</p><h2>Reliable ML starts before the model.</h2></div>
        <div class="intro-copy"><p>SCMLE is built for teams who need a defensible path from raw data to a deployed decision.</p><p><strong>Mathematics</strong> makes assumptions explicit. <strong>Engineering</strong> makes them repeatable: contracts, checkpoints, signed artifacts, and observability around every meaningful decision.</p></div>
        <div class="pillars">
          {pillars.map((pillar) => <article class="pillar"><span class="pillar-number">{pillar.number}</span><h3>{pillar.title}</h3><p>{pillar.copy}</p></article>)}
        </div>
      </section>

      <section class="capability-section" id="capabilities">
        <div class="shell capability-grid">
          <div><p class="eyebrow light"><span></span> Built for real tables</p><h2>Meet your data<br /><em>where it is.</em></h2><p class="light-copy">From a clean Parquet file to a streaming table with missing labels, the workflow starts with the dataset—not an assumption about the model.</p><a class="button button-light" href={`${base}/docs/data/`}>Read the data docs <span>→</span></a></div>
          <ul class="capabilities">{capabilities.map((capability, index) => <li><span>0{index + 1}</span><p>{capability}</p><b>↗</b></li>)}</ul>
        </div>
      </section>

      <section class="closing shell">
        <p class="eyebrow"><span></span> Mathematics meets engineering</p>
        <h2>Build systems<br /><em>you can defend.</em></h2>
        <p>Start with a tiny table, inspect every decision, then bring the same disciplined workflow to your real data.</p>
        <a class="button button-primary" href={`${base}/docs/quickstart/`}>Start the quickstart <span>→</span></a>
      </section>
    </main>

    <footer class="footer shell"><a class="brand" href={`${base}/`}><img class="brand-logo" src={`${base}/scmle-mark.svg`} alt="" /><span>SCMLE</span></a><span>Mathematics meets engineering</span><span>© 2026</span></footer>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap');
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; color: #18231f; background: #f5f4ef; font-family: 'DM Sans', sans-serif; }
  .shell { width: min(1180px, calc(100% - 64px)); margin-inline: auto; }
  .nav { align-items: center; display: flex; justify-content: space-between; min-height: 88px; }
  .brand { align-items: center; color: #18231f; display: inline-flex; font-size: 15px; font-weight: 700; gap: 9px; letter-spacing: .04em; text-decoration: none; }
  .brand-logo { height: 30px; width: 30px; }
  nav { display: flex; gap: 32px; margin-left: 110px; }
  nav a, .text-link { color: #65716c; font: 12px 'DM Mono', monospace; text-decoration: none; }
  nav a:hover, .text-link:hover { color: #18231f; }
  .nav-cta { border-bottom: 1px solid #18231f; color: #18231f; font: 12px 'DM Mono', monospace; padding-bottom: 5px; text-decoration: none; }
  .nav-cta span, .button span { margin-left: 14px; }
  .hero { display: grid; gap: 40px; grid-template-columns: 1fr 1fr; min-height: 650px; padding: 100px 0 90px; }
  .hero-copy { padding-top: 37px; }
  .eyebrow { align-items: center; color: #65716c; display: flex; font: 11px 'DM Mono', monospace; gap: 9px; letter-spacing: .02em; text-transform: uppercase; }
  .eyebrow span { background: #9eaf2e; border-radius: 50%; height: 6px; width: 6px; }
  h1, h2 { font-size: clamp(54px, 7vw, 94px); font-weight: 500; letter-spacing: -.075em; line-height: .96; margin: 27px 0; }
  h1 em, h2 em { color: #9eaf2e; font-family: 'Fraunces', serif; font-style: italic; font-weight: 500; letter-spacing: -.06em; }
  .lede { color: #65716c; font-size: 17px; line-height: 1.55; max-width: 455px; }
  .hero-actions { align-items: center; display: flex; gap: 25px; margin-top: 38px; }
  .button { display: inline-flex; font: 12px 'DM Mono', monospace; padding: 16px 20px; text-decoration: none; }
  .button-primary { background: #18231f; color: #f5f4ef; }
  .button-primary:hover { background: #31413a; }
  .hero-art { min-height: 480px; position: relative; }
  .orbit { border: 1px solid #d9ddd2; border-radius: 50%; left: 50%; position: absolute; top: 50%; transform: translate(-50%, -50%) rotate(-22deg); }
  .orbit-one { height: 420px; width: 420px; }
  .orbit-two { height: 315px; transform: translate(-50%, -50%) rotate(38deg); width: 520px; }
  .data-card { background: #fffffb; border: 1px solid #d9ddd2; box-shadow: 0 22px 70px rgba(25, 42, 34, .08); }
  .card-main { left: 50%; padding: 25px; position: absolute; top: 50%; transform: translate(-50%, -50%) rotate(-5deg); width: 310px; }
  .card-top, .card-foot { align-items: center; display: flex; font: 10px 'DM Mono', monospace; justify-content: space-between; text-transform: uppercase; }
  .card-top b { color: #9eaf2e; font-weight: 500; }
  .status-dot { background: #9eaf2e; border-radius: 50%; height: 7px; margin-right: auto; width: 7px; }
  .signal { align-items: center; display: flex; gap: 10px; margin: 27px 0; }
  .signal-label { color: #65716c; font: 10px 'DM Mono', monospace; width: 57px; }
  .signal-bar { background: #edf0e7; height: 6px; width: 105px; } .signal-bar i { background: #b7c746; display: block; height: 100%; }
  .signal strong { color: #65716c; font: 10px 'DM Mono', monospace; font-weight: 400; }
  .card-foot { border-top: 1px solid #e8e9e2; color: #9ca69f; padding-top: 15px; }
  .card-chip { align-items: center; display: flex; font: 10px 'DM Mono', monospace; gap: 10px; padding: 12px 15px; position: absolute; }
  .chip-left { left: 2%; top: 23%; transform: rotate(-10deg); } .chip-right { bottom: 21%; right: 3%; transform: rotate(7deg); }
  .chip-icon { color: #9eaf2e; font-size: 16px; }
  .crosshair { color: #9eaf2e; font-size: 30px; position: absolute; right: 12%; top: 9%; }
  .ticker { background: #d9e96a; overflow: hidden; }
  .ticker-inner { align-items: center; display: flex; font: 11px 'DM Mono', monospace; gap: 37px; justify-content: space-between; letter-spacing: .05em; min-height: 63px; white-space: nowrap; }
  .ticker-inner i { font-size: 18px; font-style: normal; }
  .approach { padding: 145px 0 155px; }
  .section-intro { display: grid; grid-template-columns: 1fr 1fr; } .section-intro h2 { font-size: clamp(45px, 5vw, 69px); margin: 0; max-width: 500px; }
  .intro-copy { color: #65716c; font-size: 16px; line-height: 1.6; margin: -35px 0 90px auto; max-width: 360px; }
  .intro-copy p + p { margin-top: 22px; }
  .pillars { border-top: 1px solid #d9ddd2; display: grid; grid-template-columns: repeat(3, 1fr); }
  .pillar { border-right: 1px solid #d9ddd2; min-height: 240px; padding: 30px 38px 30px 0; } .pillar + .pillar { padding-left: 38px; } .pillar:last-child { border: 0; }
  .pillar-number { color: #9eaf2e; font: 11px 'DM Mono', monospace; } .pillar h3 { font-size: 21px; font-weight: 500; letter-spacing: -.04em; margin: 43px 0 15px; } .pillar p { color: #65716c; font-size: 14px; line-height: 1.55; max-width: 260px; }
  .capability-section { background: #18231f; color: #f5f4ef; padding: 125px 0; } .capability-grid { display: grid; gap: 100px; grid-template-columns: 1fr 1fr; } .light { color: #b4c0b9; } .capability-section h2 { font-size: clamp(48px, 5vw, 72px); margin: 25px 0; } .light-copy { color: #b4c0b9; line-height: 1.6; max-width: 385px; } .button-light { background: #d9e96a; color: #18231f; margin-top: 30px; }
  .capabilities { list-style: none; margin: 0; padding: 0; } .capabilities li { align-items: center; border-bottom: 1px solid #39463f; display: flex; gap: 20px; min-height: 95px; } .capabilities li:first-child { border-top: 1px solid #39463f; } .capabilities li span { color: #b4c0b9; font: 10px 'DM Mono', monospace; } .capabilities li p { flex: 1; font-size: 15px; line-height: 1.4; } .capabilities li b { color: #d9e96a; font-weight: 400; }
  .closing { padding: 150px 0 165px; } .closing h2 { font-size: clamp(57px, 8vw, 104px); margin: 26px 0 30px; } .closing > p:not(.eyebrow) { color: #65716c; line-height: 1.6; max-width: 310px; } .closing .button { margin-top: 18px; }
  .footer { align-items: center; border-top: 1px solid #d9ddd2; color: #9ca69f; display: flex; font: 10px 'DM Mono', monospace; justify-content: space-between; min-height: 100px; } .footer .brand { color: #18231f; font-family: 'DM Sans', sans-serif; font-size: 13px; }
  @media (max-width: 760px) { .shell { width: min(100% - 40px, 540px); } nav { display: none; } .nav-cta { margin-left: auto; } .hero { display: block; min-height: auto; padding: 70px 0 55px; } h1 { font-size: 60px; } .hero-art { margin: 25px -20px 0; transform: scale(.82); transform-origin: top center; } .ticker-inner { gap: 22px; justify-content: flex-start; overflow: hidden; } .approach { padding: 90px 0; } .section-intro { display: block; } .section-intro h2 { margin-top: 30px; } .intro-copy { margin: 35px 0 60px; } .pillars, .capability-grid { display: block; } .pillar, .pillar + .pillar { border-bottom: 1px solid #d9ddd2; border-right: 0; min-height: auto; padding: 25px 0; } .pillar h3 { margin: 25px 0 10px; } .capability-section { padding: 85px 0; } .capabilities { margin-top: 70px; } .closing { padding: 100px 0; } .footer { align-items: flex-start; flex-direction: column; gap: 15px; padding: 25px 0; } }
</style>
