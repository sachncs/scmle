---
import BaseLayout from "../layouts/BaseLayout.astro";
import Leaderboard from "../components/Leaderboard.astro";
import Glyph from "../components/Glyph.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const repo = "https://github.com/sachncs/scmle";

// Captured from a local run of scmle 0.1.0b1 on scikit-learn's breast-cancer
// table (569 rows, 60 s budget). Best cross-validated ROC-AUC per model family.
const families = [
  { name: "bagged_logistic_regression", score: 0.9947, win: true },
  { name: "logistic_regression", score: 0.9938 },
  { name: "hist_gradient_boosting", score: 0.9924 },
  { name: "knn", score: 0.9867 },
  { name: "bagged_decision_tree", score: 0.9848 },
  { name: "decision_tree", score: 0.9213 },
  { name: "dummy", score: 0.5 },
];

const quickstart = `<span class="tok-k">import</span> logging

<span class="tok-k">import</span> scmle

logging.basicConfig(level=logging.INFO)
project = scmle.MLProject(<span class="tok-s">"customers.parquet"</span>, target=<span class="tok-s">"churn"</span>, metric=<span class="tok-s">"roc_auc"</span>)
logging.info(project.plan().summary())  <span class="tok-c"># inspect before any training</span>
result = project.run()  <span class="tok-c"># profile, split, search, test, package</span>
logging.info(<span class="tok-s">"\\n%s"</span>, result.leaderboard())
result.save(<span class="tok-s">"artifacts/churn"</span>, signing_key=<span class="tok-s">"..."</span>)  <span class="tok-c"># signed with your key</span>
result.predict(<span class="tok-s">"new_customers.parquet"</span>)`;

const output = `<span class="tok-c"># project.plan().summary(), first line</span>
Plan plan_59f5a6e13d: binary_classification, metric=roc_auc,
  validation=stratified, budget=60s

<span class="tok-c"># result.leaderboard(), first rows</span>
model_name                  status  score_mean  score_std
bagged_logistic_regression  ok          0.9947     0.0063
stacking                    ok          0.9947     0.0062
bagged_logistic_regression  ok          0.9946     0.0061

<span class="tok-c"># result.summary()</span>
selected bagged_logistic_regression (cv roc_auc=0.9947);
test: roc_auc=0.9960, pr_auc=0.9976, log_loss=0.1002,
f1=0.9861, balanced_accuracy=0.9812, accuracy=0.9825`;

const planLines = `<span class="tok-c"># project.plan().summary(), excerpt</span>
[include] logistic_regression: linear (cost 1)
[include] hist_gradient_boosting: boosting (cost 3)
[include] stacking: best of up to 3 distinct models,
          adopted only if it beats its best
          member in cross-validation
[reject]  lightgbm: missing dependency: lightgbm
[reject]  smote: not applicable: classes are
          balanced enough (1.7:1 < 3:1)
[reject]  torch_jepa: experimental-only; needs
          explicit opt-in`;

const bundle = `artifacts/churn/
├── model_manifest.json
├── pipeline.joblib
├── reference.json    <span class="tok-c"># monitoring reference</span>
├── schema.json
└── signature.json    <span class="tok-c"># HMAC over the manifest</span>`;

const install = `<span class="cmd">$ </span>pip install "scmle @ git+https://github.com/sachncs/scmle" <span class="tok-c"># core</span>
<span class="cmd">$ </span>pip install "scmle[boosting] @ git+https://github.com/sachncs/scmle" <span class="tok-c"># + LightGBM, XGBoost</span>
<span class="cmd">$ </span>pip install "scmle[all] @ git+https://github.com/sachncs/scmle" <span class="tok-c"># most optional extras</span>`;

const aheadRows = [
  { label: "Nine core datasets", ahead: 7, total: 9 },
  { label: "20 Hugging Face Hub tables", ahead: 16, total: 20 },
  { label: "21 further OpenML tables", ahead: 13, total: 21 },
];
const bw = 360;
---

<BaseLayout
  title="SCMLE: Mathematics meets engineering"
  fullTitle
  description="SCMLE is a curation-first machine learning lifecycle: leakage-safe evaluation behind a locked test set, a planned search over compatible candidates within your budget, and checksummed, auditable artifacts you can authenticate with a signing key."
  path="/"
  section="home"
>
  <main id="main">
    <!-- Hero -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="container">
        <p class="badge rise" style="--d:0"><i></i> Open source · Apache-2.0 · 0.1 beta</p>
        <h1 id="hero-title" class="rise" style="--d:1">Mathematics meets engineering.</h1>
        <p class="lede rise" style="--d:2">A curation-first machine learning lifecycle. It profiles your data, splits behind a locked test set, plans compatible candidates and searches within the configured budget, and writes a checksummed bundle with the evidence behind every choice. Configure a signing key to authenticate the bundle.</p>
        <div class="cta-row rise" style="--d:3">
          <a class="btn btn-primary" href={`${base}/docs/quickstart/`}>Get started</a>
          <a class="btn btn-secondary" href={repo}>View on GitHub</a>
        </div>
        <p class="hero-meta rise" style="--d:3"><a class="link-arrow" href={`${base}/docs/start-here/`}>New to machine learning? Start here: your first model in 30 minutes →</a></p>
        <p class="hero-meta rise" style="--d:4"><code>pip install "scmle @ git+https://github.com/sachncs/scmle"</code></p>

        <figure class="hero-visual rise" style="--d:5">
          <div class="result">
            <div class="result-head"><span>breast_cancer · roc_auc</span><b>run complete</b></div>
            <div class="result-body">
              <p class="result-plan">binary_classification · validation=stratified · 60 s budget<br />Cross-validated ROC-AUC, best per model family</p>
              <Leaderboard rows={families} idPrefix="hero" />
            </div>
            <div class="result-foot">
              <div class="stat"><span>Selected</span><strong>bagged logistic</strong></div>
              <div class="stat"><span>CV ROC-AUC</span><strong>0.9947</strong></div>
              <div class="stat"><span>Locked test</span><strong class="accent">0.9960</strong></div>
            </div>
          </div>
          <figcaption class="source">Real output, captured from a local run of scmle 0.1.0b1 on scikit-learn's breast-cancer table (569 rows). The dummy baseline sits at 0.5, which is chance. One run, one seed: not a benchmark.</figcaption>
        </figure>
      </div>
    </section>

    <!-- Story 1: profile -->
    <section class="section" id="lifecycle" aria-labelledby="s-profile">
      <div class="container">
        <div class="story">
          <div class="story-text reveal">
            <p class="kicker">01 · Profile</p>
            <h2 class="h2" id="s-profile">Know the data before the model does.</h2>
            <p class="sub">Before anything trains, SCMLE reads the table, resolves the task, fingerprints the data and raises leakage hypotheses.</p>
            <a class="link-arrow" href={`${base}/docs/data/`}>Data and curation →</a>
          </div>
          <div class="panel reveal" data-delay="1">
            <p class="panel-title">profile</p>
            <ul class="checks">
              <li><b>Task</b><span>Resolved from the target and the declared metric</span></li>
              <li><b>Column kinds</b><span>Numeric, categorical, datetime and more, validated</span></li>
              <li><b>Fingerprint</b><span>A full dataset fingerprint that ties results to the data</span></li>
              <li><b>Leakage</b><span><em class="flag">boat</em><em class="flag">body</em> flagged on the Titanic table: outcome-dependent recording</span></li>
            </ul>
            <div class="callout-inline"><p>With <code>leakage_policy="block"</code> (opt-in; the default is <code>"warn"</code>) the run refuses to proceed. A flag is a statistical suspicion, not proof; see <a href={`${base}/docs/leakage/`}>what the leakage screen can and cannot tell you</a>. Titanic's unusually high score comes from those two columns, which is why the profiler flags them.</p></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Story 2: split -->
    <section class="section section-alt" aria-labelledby="s-split">
      <div class="container">
        <div class="story flip">
          <div class="story-text reveal">
            <p class="kicker">02 · Split</p>
            <h2 class="h2" id="s-split">Split without leakage. Open the test set once.</h2>
            <p class="sub">Stratified, random, group or temporal splits keep the test rows behind a vault. Every statistic is learned on training folds only.</p>
            <ul>
              <li>Preprocessing, resampling, calibration and stacking are fitted inside each fold.</li>
              <li>Only the target is looked at before the split.</li>
              <li>The locked test set is evaluated once, after selection.</li>
            </ul>
            <a class="link-arrow" href={`${base}/docs/evidence/`}>Evidence and gates →</a>
          </div>
          <figure class="panel reveal" data-delay="1" style="margin:0">
            <svg class="diagram-svg" viewBox="0 0 400 380" role="img" aria-labelledby="split-t split-d">
              <title id="split-t">How a table is split</title>
              <desc id="split-d">All rows are split into development rows and a locked test set. Inside the development rows, cross-validation folds fit features, resampling, calibration and stacking per fold. The selected model is evaluated once on the locked test rows.</desc>
              <rect class="box" x="6" y="6" width="388" height="44" rx="10" />
              <text class="t-strong" x="200" y="34" text-anchor="middle">All rows</text>
              <path class="line" d="M110 50v40M345 50v40" />
              <rect class="box" x="6" y="90" width="290" height="190" rx="12" />
              <text class="t-strong" x="22" y="118">Development rows</text>
              <rect class="fold" x="22" y="132" width="46" height="30" rx="6" />
              <rect class="fold" x="74" y="132" width="46" height="30" rx="6" />
              <rect class="fold-v" x="126" y="132" width="46" height="30" rx="6" />
              <rect class="fold" x="178" y="132" width="46" height="30" rx="6" />
              <rect class="fold" x="230" y="132" width="46" height="30" rx="6" />
              <text x="149" y="152" text-anchor="middle" class="t-accent" style="font-size:11px">valid</text>
              <text x="22" y="190">Cross-validation folds</text>
              <text x="22" y="222" class="t-mono">features · resampling</text>
              <text x="22" y="242" class="t-mono">calibration · stacking</text>
              <text x="22" y="262" class="t-mono">all fitted inside each fold</text>
              <rect class="box-lock" x="308" y="90" width="86" height="190" rx="12" />
              <text class="t-strong" x="351" y="170" text-anchor="middle">Locked</text>
              <text class="t-strong" x="351" y="190" text-anchor="middle">test set</text>
              <text x="351" y="214" text-anchor="middle" class="t-accent" style="font-size:12px">opens once</text>
              <path class="line-a" d="M110 280v40M351 280v40" />
              <rect class="box-a" x="6" y="320" width="388" height="54" rx="10" />
              <text class="t-strong" x="200" y="342" text-anchor="middle">Selected model</text>
              <text x="200" y="362" text-anchor="middle">evaluated once on the locked rows</text>
            </svg>
            <figcaption class="note" style="margin-top:12px">Illustrative diagram of the workflow described in the README.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Story 3: search -->
    <section class="section" aria-labelledby="s-search">
      <div class="container">
        <div class="story">
          <div class="story-text reveal">
            <p class="kicker">03 · Search</p>
            <h2 class="h2" id="s-search">Plan compatible candidates. Search within your budget. Justify the winner.</h2>
            <p class="sub">scikit-learn, LightGBM, XGBoost, CatBoost, SVM and kNN, plus data strategies and pruned tuning. A stack is adopted only if it beats its best member.</p>
            <ul>
              <li>Every rejected candidate comes with a reason.</li>
              <li>Optional serving limits on model size and p95 latency.</li>
              <li>Parallel trials with failure isolation and resumable checkpoints.</li>
            </ul>
            <a class="link-arrow" href={`${base}/docs/modeling/`}>Modelling and estimation →</a>
          </div>
          <div class="code-block reveal" data-delay="1">
            <div class="code-label">plan · nothing has trained yet</div>
            <pre tabindex="0"><code set:html={planLines}></code></pre>
          </div>
        </div>
      </div>
    </section>

    <!-- Story 4: evidence -->
    <section class="section tone-inverse" id="evidence" aria-labelledby="s-evidence">
      <div class="container">
        <div class="story flip">
          <div class="story-text reveal">
            <p class="kicker">04 · Evidence</p>
            <h2 class="h2" id="s-evidence">A checksummed bundle, and the decisions behind it.</h2>
            <p class="sub">Every run writes its configuration, split, events, trials, decision log and data-access ledger. The model is written as a checksummed bundle; with a signing key configured it is signed as well.</p>
            <ul>
              <li>Bundles are pickle-based, so loading is refused unless the HMAC signature verifies, or you pass <code>trusted=True</code>.</li>
              <li>Checksums are verified before anything is unpickled.</li>
            </ul>
            <a class="link-arrow" href={`${base}/docs/security/`}>Security →</a>
          </div>
          <div class="reveal" data-delay="1">
            <div class="code-block">
              <div class="code-label">result.save("artifacts/churn", signing_key=...)</div>
              <pre tabindex="0"><code set:html={bundle}></code></pre>
            </div>
            <div class="panel" style="margin-top:16px">
              <ul class="sig-list">
                <li><code>signature verifies</code><span>bundle loads</span></li>
                <li><code>wrong key or modified file</code><span>ArtifactError</span></li>
                <li><code>no key, no trusted=True</code><span>load refused</span></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Story 5: monitoring -->
    <section class="section" aria-labelledby="s-monitor">
      <div class="container">
        <div class="story">
          <div class="story-text reveal">
            <p class="kicker">05 · Monitor</p>
            <h2 class="h2" id="s-monitor">Operate it like a product, not a notebook.</h2>
            <p class="sub">Monitor drift and delayed-label performance, compare a challenger with the champion, then version and promote. Serve in batch or over HTTP.</p>
            <a class="link-arrow" href={`${base}/docs/operations/`}>Operations →</a>
          </div>
          <figure class="panel reveal" data-delay="1" style="margin:0">
            <svg class="diagram-svg" viewBox="0 0 420 360" role="img" aria-labelledby="mon-t mon-d">
              <title id="mon-t">The operating loop</title>
              <desc id="mon-d">Five steps in order: a reference profile ships inside the bundle; live inputs are checked for drift against it; delayed labels are used to measure performance; a challenger is compared with the champion; the winner is versioned and promoted.</desc>
              {[
                ["Reference profile", "ships inside the bundle"],
                ["Drift on live inputs", "compared with the reference"],
                ["Delayed-label performance", "measured when labels arrive"],
                ["Challenger vs champion", "compared before any swap"],
                ["Version and promote", "registry with lifecycle states"],
              ].map(([a, b], i) => (
                <g transform={`translate(0 ${i * 72})`}>
                  <rect class={i === 3 || i === 4 ? "box-a" : "box"} x="8" y="4" width="404" height="54" rx="12" />
                  <circle cx="38" cy="31" r="12" class="fold" />
                  <text x="38" y="35.5" text-anchor="middle" class="t-strong" style="font-size:13px">{i + 1}</text>
                  <text x="64" y="27" class="t-strong" style="font-size:15px">{a}</text>
                  <text x="64" y="46" style="font-size:13.5px">{b}</text>
                  {i < 4 && <path class="line" d="M38 58v14" />}
                </g>
              ))}
            </svg>
            <figcaption class="note" style="margin-top:12px">Illustrative diagram of the monitoring module described in the README.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Bento -->
    <section class="section section-alt" id="capabilities" aria-labelledby="cap-title">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">Capabilities</p>
          <h2 class="h2" id="cap-title">Everything the lifecycle needs. Nothing you have to guess.</h2>
        </div>
        <div class="bento">
          <article class="tile wide feature reveal">
            <Glyph name="graph" />
            <h3>Declarative features, learned in-fold</h3>
            <p><code>FeatureGraphSpec</code>: ratios, bins, clipping, datetime parts, lags and rolling statistics per entity. Every statistic is learned on the training fold only.</p>
          </article>
          <article class="tile reveal" data-delay="1">
            <Glyph name="search" />
            <h3>Search with a budget</h3>
            <p>Random or Optuna tuning with pruning, run in a process pool or Ray.</p>
          </article>
          <article class="tile reveal">
            <Glyph name="gauge" />
            <h3>Selection under constraints</h3>
            <p>Cross-validation, serving limits, and a decision threshold optimised against an explicit cost or metric.</p>
          </article>
          <article class="tile reveal" data-delay="1">
            <Glyph name="eye" />
            <h3>Explain the result</h3>
            <p>Diagnostics, permutation importance and structure-aware confidence intervals.</p>
          </article>
          <article class="tile reveal" data-delay="2">
            <Glyph name="stop" />
            <h3>Conservative by default</h3>
            <p>Ambiguous targets, impossible constraints or rejected approvals put the run in <code>BLOCKED</code> instead of guessing.</p>
          </article>
          <article class="tile half reveal">
            <Glyph name="lock" />
            <h3>Governance</h3>
            <p>Access ledger verified against the split, a content-addressed model registry and approval checkpoints on the plan and the selection.</p>
          </article>
          <article class="tile half reveal" data-delay="1">
            <Glyph name="server" />
            <h3>Command line and serving</h3>
            <p>One command surface that mirrors the Python API.</p>
            <div class="chips"><span>plan</span><span>run</span><span>resume</span><span>predict</span><span>serve</span><span>package</span></div>
          </article>
          <article class="tile wide reveal">
            <Glyph name="layers" />
            <h3>Reads real tables</h3>
            <p>CSV, Parquet, and Arrow or Polars interchange. Tabular is the supported path today; other modalities are documented in the capability matrix with their status.</p>
            <div class="chips"><span>CSV</span><span>Parquet</span><span>Arrow</span><span>Polars</span></div>
          </article>
          <article class="tile reveal" data-delay="1">
            <Glyph name="puzzle" />
            <h3>Extensible</h3>
            <p>Add a reader, split strategy or model adapter by subclassing. No core edits.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Code to result -->
    <section class="section" id="quickstart" aria-labelledby="qs-title">
      <div class="container">
        <div class="section-head center reveal">
          <p class="kicker">Quickstart</p>
          <h2 class="h2" id="qs-title">From a table to a model bundle.</h2>
          <p class="sub">The quickstart from the README, and what the same calls print.</p>
        </div>
        <div class="code-grid">
          <div class="code-block reveal">
            <div class="code-label">python · README quickstart</div>
            <pre tabindex="0"><code set:html={quickstart}></code></pre>
          </div>
          <div class="code-block reveal" data-delay="1">
            <div class="code-label">output · local run on the breast-cancer table</div>
            <pre tabindex="0"><code set:html={output}></code></pre>
          </div>
        </div>
        <p class="note reveal" style="margin-top:16px;text-align:center">Output comes from running these calls on scikit-learn's breast-cancer data with <code>time_budget=60</code>. Trial order can differ between runs. <a href={`${base}/docs/quickstart/`}>Full command-line quickstart</a>.</p>
      </div>
    </section>

    <!-- Benchmarks -->
    <section class="section section-alt" id="benchmarks" aria-labelledby="bm-title">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">Benchmarks</p>
          <h2 class="h2" id="bm-title">Measured against a plain baseline, including where it loses.</h2>
          <p class="sub">The reference is scikit-learn's <code>HistGradientBoosting</code>, fitted on the same development rows and scored on the same locked test rows.</p>
        </div>
        <div class="bench-grid">
          <figure class="panel reveal" style="margin:0">
            <svg class="chart" viewBox={`0 0 ${bw} 214`} role="img" aria-labelledby="bm-t bm-d">
              <title id="bm-t">Datasets where SCMLE scored ahead of the reference</title>
              <desc id="bm-d">Nine core datasets: ahead on 7 of 9. Twenty Hugging Face Hub tables: ahead on 16 of 20. Twenty-one OpenML tables: ahead on 13 of 21.</desc>
              {aheadRows.map((r, i) => (
                <g transform={`translate(0 ${i * 66})`}>
                  <text x="0" y="14">{r.label}</text>
                  <text x={bw} y="14" text-anchor="end" class="val">{r.ahead} of {r.total} ahead</text>
                  <rect class="track" x="0" y="24" width={bw} height="12" rx="6" />
                  <rect class="bar win" style={`--i:${i * 2}`} x="0" y="24" width={(r.ahead / r.total) * bw} height="12" rx="6" />
                </g>
              ))}
              <text x="0" y="206" class="muted" style="font-size:11.5px">Bar length is the share of datasets ahead of the reference.</text>
            </svg>
            <div class="bench-note">
              <p class="note">One split and one seed per dataset: differences in the fourth digit are within noise. With three seeds and 95% intervals, only one of four bundled datasets was distinguishable from the reference (diabetes progression, ahead).</p>
              <p class="note"><strong>Scope.</strong> Commit <code>491dd24</code> recorded these results. Nine datasets: four bundled, five OpenML (versions not pinned). 400 s budget, 2 workers, every optional extra installed, hardware not recorded. <code>leakage_policy="warn"</code> is set explicitly by the benchmark runner, so these scores do not show the behaviour of <code>"block"</code>. One split and one seed per dataset; nine of nine runs finished. Reference: a plain scikit-learn <code>HistGradientBoosting</code> on the same rows. <strong>No AutoML head-to-head result exists</strong>, so nothing here supports a claim of superiority over other AutoML systems. Reproduce: <code>python -m benchmarks.run_benchmarks --budget 400 --workers 2</code> from a source checkout.</p>
              <a class="link-arrow" href={`${base}/docs/benchmarks/#what-this-shows`}>Full scope, repeated-seed intervals and all tables →</a>
            </div>
          </figure>
          <div class="reveal" data-delay="1">
            <div class="table-wrap" tabindex="0" role="region" aria-label="Selected benchmark results, scrollable">
              <table class="data">
                <caption>Single-seed locked-test scores (point estimates; the repeated-seed intervals are on the benchmarks page)</caption>
                <thead><tr><th scope="col">Dataset</th><th scope="col">Metric</th><th scope="col" class="num">SCMLE</th><th scope="col" class="num">Reference</th></tr></thead>
                <tbody>
                  <tr><th scope="row">breast_cancer</th><td>roc_auc</td><td class="num ahead">0.9940</td><td class="num">0.9901</td></tr>
                  <tr><th scope="row">credit-g</th><td>roc_auc</td><td class="num ahead">0.7823</td><td class="num">0.7479</td></tr>
                  <tr><th scope="row">titanic*</th><td>roc_auc</td><td class="num ahead">0.9920</td><td class="num">0.9910</td></tr>
                  <tr><th scope="row">wine</th><td>log_loss ↓</td><td class="num behind">0.1049</td><td class="num">0.0099</td></tr>
                  <tr><th scope="row">kc1 defects</th><td>pr_auc</td><td class="num behind">0.4991</td><td class="num">0.5249</td></tr>
                  <tr><th scope="row">california housing</th><td>rmse ↓</td><td class="num ahead">47321</td><td class="num">49378</td></tr>
                </tbody>
              </table>
            </div>
            <p class="note" style="margin-top:12px">Six of nine core rows shown; all nine are on the <a href={`${base}/docs/benchmarks/#core`}>benchmarks page</a>. Lower is better for log loss and RMSE. *Titanic's score comes from leaked columns that the profiler flags.</p>
            <div class="panel" style="margin-top:var(--s3)">
              <p class="panel-title">python -m benchmarks.reliability · nine checks</p>
              <ul class="sig-list">
                <li><code>no_false_skill</code><span>noise labels stay near 0.5</span></li>
                <li><code>leak_detection</code><span>planted leak is found</span></li>
                <li><code>tamper_detection</code><span>wrong key refused</span></li>
                <li><code>failure_isolation</code><span>one crash, run completes</span></li>
              </ul>
              <p class="note" style="margin:12px 0 0">Four of nine shown. <a href={`${base}/docs/benchmarks/#reliability-checks`}>All nine, with thresholds</a>.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust -->
    <section class="section" id="trust" aria-labelledby="trust-title">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker">Trust</p>
          <h2 class="h2" id="trust-title">Guarantees you can check, limits we state.</h2>
        </div>
        <div class="trust-grid">
          <div class="trust-item reveal"><h3>Leakage-aware evaluation</h3><p>Preprocessing, resampling, calibration and stacking are fitted inside each fold as part of the candidate. The leakage tests check, under stated conditions, that perturbing the test partition does not change the search; that is evidence for the tested scenarios, not a proof for every dataset.</p></div>
          <div class="trust-item reveal" data-delay="1"><h3>Auditable</h3><p>Configuration, split, events, trials, decision log, data-access ledger, report and bundle are written for every run. Replays are classed <code>exact</code>, <code>comparable</code> or <code>different</code>.</p></div>
          <div class="trust-item reveal" data-delay="2"><h3>Secure by default</h3><p>Bundles are checksummed, and are authenticated when you configure a signing key; loading an unsigned bundle is refused unless you vouch for it. CI runs <code>bandit</code> and <code>pip-audit</code>, and builds the wheel into a clean environment.</p></div>
        </div>
        <div class="limits reveal">
          <h3>Known limits</h3>
          <ul>
            <li>The test-set vault keeps locked rows out of trial processes. It does not prevent access to the original data file, and a caller's own in-memory table still holds every row.</li>
            <li>The HTTP serving adapter is a minimal reference server. It verifies bearer tokens when configured and has no TLS, so run it behind an ingress.</li>
            <li>The public API may change between <code>0.x</code> releases. SCMLE is in beta.</li>
          </ul>
          <a class="link-arrow" href={`${base}/docs/architecture/#known-limits`} style="display:inline-block;margin-top:16px">All known limits →</a>
        </div>

        <div class="dev reveal" style="margin-top:var(--s8)">
          <div>
            <span class="tag">In development</span>
            <h3>The qualification instrument</h3>
            <p>A data-stage instrument that turns a signed charter into tier-labelled claims about a dataset: custody of held-out sets, a hash-chained hypothesis ledger, one-time confirmation, and detectors that gate only with a measured certificate. It is built and tested but not independently validated, several detectors remain descriptive, and its guarantees are probabilistic and conditional on recorded assumptions.</p>
          </div>
          <a class="link-arrow" href={`${base}/docs/qualification/`}>How the instrument works →</a>
        </div>
      </div>
    </section>

    <!-- Install -->
    <section class="section section-alt install" id="install" aria-labelledby="install-title">
      <div class="container">
