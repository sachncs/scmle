{
  "controls": {
    "approved_steps": [
      "batch_predict"
    ],
    "concurrency_groups": {
      "train": [
        "train",
        1
      ]
    },
    "max_concurrent_runs": 1,
    "run_cost_budget": null,
    "step_cost_budgets": {}
  },
  "definition": {
    "main": {
      "params": [
        "args"
      ],
      "steps": [
        {
          "init": {
            "assign": [
              {
                "execution_key": "${args.execution_key}"
              }
            ]
          }
        },
        {
          "ingest": {
            "except": {
              "as": "error",
              "steps": [
                {
                  "ingest_failed": {
                    "raise": "${error}"
                  }
                }
              ]
            },
            "retry": {
              "backoff": {
                "initial_delay": 2.0,
                "max_delay": 60.0,
                "multiplier": 2.0
              },
              "max_retries": 2,
              "predicate": "${retry_predicate}"
            },
            "try": {
              "steps": [
                {
                  "ingest_call": {
                    "args": {
                      "body": {
                        "overrides": {
                          "containerOverrides": [
                            {
                              "env": [
                                {
                                  "name": "SCMLE_STEP",
                                  "value": "ingest"
                                },
                                {
                                  "name": "SCMLE_IDEMPOTENCY_KEY",
                                  "value": "${execution_key}"
                                }
                              ]
                            }
                          ],
                          "timeout": "3600s"
                        }
                      },
                      "name": "JOB_RESOURCE_NAME"
                    },
                    "call": "googleapis.run.v2.projects.locations.jobs.run",
                    "result": "ingest_result"
                  }
                }
              ]
            }
          }
        },
        {
          "train": {
            "except": {
              "as": "error",
              "steps": [
                {
                  "train_failed": {
                    "raise": "${error}"
                  }
                }
              ]
            },
            "retry": {
              "backoff": {
                "initial_delay": 2.0,
                "max_delay": 60.0,
                "multiplier": 2.0
              },
              "max_retries": 2,
              "predicate": "${retry_predicate}"
            },
            "try": {
              "steps": [
                {
                  "train_call": {
                    "args": {
                      "body": {
                        "overrides": {
                          "containerOverrides": [
                            {
                              "env": [
                                {
                                  "name": "SCMLE_STEP",
                                  "value": "train"
                                },
                                {
                                  "name": "SCMLE_IDEMPOTENCY_KEY",
                                  "value": "${execution_key}"
                                }
                              ]
                            }
                          ],
                          "timeout": "3600s"
                        }
                      },
                      "name": "JOB_RESOURCE_NAME"
                    },
                    "call": "googleapis.run.v2.projects.locations.jobs.run",
                    "result": "train_result"
                  }
                }
              ]
            }
          }
        },
        {
          "evaluate": {
            "except": {
              "as": "error",
              "steps": [
                {
                  "evaluate_failed": {
                    "raise": "${error}"
                  }
                }
              ]
            },
            "retry": {
              "backoff": {
                "initial_delay": 2.0,
                "max_delay": 60.0,
                "multiplier": 2.0
              },
              "max_retries": 2,
              "predicate": "${retry_predicate}"
            },
            "try": {
              "steps": [
                {
                  "evaluate_call": {
                    "args": {
                      "body": {
                        "overrides": {
                          "containerOverrides": [
                            {
                              "env": [
                                {
                                  "name": "SCMLE_STEP",
                                  "value": "evaluate"
                                },
                                {
                                  "name": "SCMLE_IDEMPOTENCY_KEY",
                                  "value": "${execution_key}"
                                }
                              ]
                            }
                          ],
                          "timeout": "3600s"
                        }
                      },
                      "name": "JOB_RESOURCE_NAME"
                    },
                    "call": "googleapis.run.v2.projects.locations.jobs.run",
                    "result": "evaluate_result"
                  }
                }
              ]
            }
          }
        },
        {
          "layer_approve_monitor": {
            "parallel": {
              "branches": [
                {
                  "branch_approve": {
                    "steps": [
                      {
                        "approve": {
                          "steps": [
                            {
                              "approve_endpoint": {
                                "args": {
                                  "http_callback_method": "POST"
                                },
                                "call": "events.create_callback_endpoint",
                                "result": "approve_callback"
                              }
                            },
                            {
                              "approve_notify": {
                                "args": {
                                  "body": {
                                    "messages": [
                                      {
                                        "attributes": {
                                          "callback": "${approve_callback.url}",
                                          "step": "approve"
                                        }
                                      }
                                    ]
                                  },
                                  "topic": "TOPIC"
                                },
                                "call": "googleapis.pubsub.v1.projects.topics.publish"
                              }
                            },
                            {
                              "approve_wait": {
                                "args": {
                                  "callback": "${approve_callback}",
                                  "timeout": 7200
                                },
                                "call": "events.await_callback",
                                "result": "approve_reply"
                              }
                            },
                            {
                              "approve_decide": {
                                "switch": [
                                  {
                                    "condition": "${approve_reply.http_request.body.decision != \"approve\"}",
                                    "raise": "approval rejected"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                },
                {
                  "branch_monitor": {
                    "steps": [
                      {
                        "monitor": {
                          "except": {
                            "as": "error",
                            "steps": [
                              {
                                "monitor_failed": {
                                  "raise": "${error}"
                                }
                              }
                            ]
                          },
                          "retry": {
                            "backoff": {
                              "initial_delay": 2.0,
                              "max_delay": 60.0,
                              "multiplier": 2.0
                            },
                            "max_retries": 2,
                            "predicate": "${retry_predicate}"
                          },
                          "try": {
                            "steps": [
                              {
                                "monitor_call": {
                                  "args": {
                                    "body": {
                                      "overrides": {
                                        "containerOverrides": [
                                          {
                                            "env": [
                                              {
                                                "name": "SCMLE_STEP",
                                                "value": "monitor"
                                              },
                                              {
                                                "name": "SCMLE_IDEMPOTENCY_KEY",
                                                "value": "${execution_key}"
                                              }
                                            ]
                                          }
                                        ],
                                        "timeout": "3600s"
                                      }
                                    },
                                    "name": "JOB_RESOURCE_NAME"
                                  },
                                  "call": "googleapis.run.v2.projects.locations.jobs.run",
                                  "result": "monitor_result"
                                }
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        },
        {
          "batch_predict": {
            "except": {
              "as": "error",
              "steps": [
                {
                  "batch_predict_failed": {
                    "raise": "${error}"
                  }
                }
              ]
            },
            "retry": {
              "backoff": {
                "initial_delay": 2.0,
                "max_delay": 60.0,
                "multiplier": 2.0
              },
              "max_retries": 2,
              "predicate": "${retry_predicate}"
            },
            "try": {
              "steps": [
                {
                  "batch_predict_call": {
                    "args": {
                      "body": {
                        "overrides": {
                          "containerOverrides": [
                            {
                              "env": [
                                {
                                  "name": "SCMLE_STEP",
                                  "value": "batch_predict"
                                },
                                {
                                  "name": "SCMLE_IDEMPOTENCY_KEY",
                                  "value": "${execution_key}"
                                }
                              ]
                            }
                          ],
                          "timeout": "3600s"
                        }
                      },
                      "name": "JOB_RESOURCE_NAME"
                    },
                    "call": "googleapis.run.v2.projects.locations.jobs.run",
                    "result": "batch_predict_result"
                  }
                }
              ]
            }
          }
        },
        {
          "finish": {
            "return": "${execution_key}"
          }
        }
      ]
    }
  },
  "schedule": "0 */1 * * *",
  "structural_problems": []
}
