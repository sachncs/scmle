# Published fixture for the local demo. It is not a secret and protects
# nothing; it exists so the demo's signed bundles can be verified. Never reuse
# it anywhere that matters.
SCMLE_SIGNING_KEY=scmle-local-demo-signing-key-published-fixture
# Local demo identity provider: the services accept HS256 tokens signed with
# this published key, and the test runner mints its own. Published fixture.
SCMLE_AUTH_HS256_SECRET=scmle-local-demo-token-key-published-fixture
SCMLE_AUTH_ISSUER=scmle-local-demo
SCMLE_AUTH_AUDIENCE=scmle-service
# Lets the services accept the published key above under production rules.
# Never set this anywhere real.
SCMLE_ALLOW_PUBLISHED_KEY=1
